# Copy to .env and fill in. Never commit .env. Names only here; defaults live in app/config.py.
# On the server these live in /opt/haloai/env/haloai.env, set with /opt/haloai/bin/set-secret.

# ---- Required ----
NEBIUS_API_KEY=            # Nebius Token Factory key (turn on Zero Data Retention for the account)
BACKEND_API_KEY=           # the phone's key; registered at startup as scope 'real'
HALOAI_DB_PASSWORD=        # used by docker-compose.yml for the local Postgres
DATABASE_URL=              # postgresql://haloai:<password>@127.0.0.1:5433/haloai
TEST_DATABASE_URL=         # postgresql://haloai:<password>@127.0.0.1:5433/haloai_test

# ---- Model and processing ----
PROCESSOR=                 # 'fake' (keyword script, no model) or 'nemotron' (the real loop)
NEMOTRON_MODEL_ID=         # default nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_BASE_URL=           # default https://api.tokenfactory.nebius.com/v1/
REASONING_ENABLED=         # reasoning on every turn (testing only); default off
REASONING_AFTER_SEARCH=    # reasoning on the turns after a web search; default on

# ---- Real Google and Tavily (B4) ----
REAL_TOOLS_ENABLED=        # 'true': real-scope keys use the connected Google account
GOOGLE_CLIENT_ID=          # OAuth client (Google Cloud console, Web application)
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=       # default https://api.haloai-cov.io/v1/google/callback
TOKEN_ENCRYPTION_KEY=      # Fernet key that encrypts stored Google refresh tokens
TAVILY_API_KEY=            # web search
WEB_SEARCH_DEPTH=          # 'basic' or 'advanced' (default)
ALLOWED_RECIPIENTS=        # the team's addresses, comma separated; outside ones are capped per day
OUTSIDE_RECIPIENTS_PER_DAY=

# ---- Demo site (B6) ----
DEMO_SITE_KEY=             # the demo site's own key (public in the page, sample data only)
DEMO_DAILY_REQUESTS=       # model requests by all sample-mode keys per 24 h (default 1000)
DEMO_DAILY_SEARCHES=       # real Tavily searches on the demo per day (default 100)
DEMO_REAL_SEARCH=          # default true

# ---- Backups (server only, B5) ----
BACKUP_AGE_RECIPIENT=      # age public key; the private key never leaves Orlando's Mac
BACKUP_PAR_URL=            # write-only Oracle Object Storage pre-authenticated URL

# ---- Screen text budget (Victor's F1 numbers) ----
SCREEN_LANDSCAPE_CHARS=
SCREEN_LANDSCAPE_LINES=
SCREEN_PORTRAIT_CHARS=
SCREEN_PORTRAIT_LINES=
