# Caddy in front of the HaloAI backend. Installed by scripts/deploy.sh to /etc/caddy/Caddyfile.
# Caddy gets and renews the HTTPS certificate for this name by itself (needs ports 80 and 443 open).
api.haloai-cov.io {
	# FastAPI's built-in docs answer without an API key; the hard constraint says every
	# API request needs one. Blocked here, before the request reaches the backend.
	@docs path /docs /docs/* /redoc /redoc/* /openapi.json
	respond @docs 404

	reverse_proxy 127.0.0.1:8000 {
		# Send Server-Sent Events to the phone as they happen, never buffered.
		flush_interval -1
	}
}

# The demo site (B6). Static files from /srv/haloai-site (published by scripts/deploy.sh, with
# config.js written from the DEMO_SITE_KEY secret), and the API on the same origin, so the
# browser needs no CORS. Only /v1/ reaches the backend; its docs pages stay unreachable.
haloai-cov.io {
	encode gzip
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
		}
	}
	handle {
		root * /srv/haloai-site
		header Cache-Control "no-cache"
		file_server
	}
}
