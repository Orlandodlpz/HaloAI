# Settings common to both boards. The board specific ones live in
# sdkconfig.defaults.crowpanel and sdkconfig.defaults.waveshare, and
# CMakeLists.txt picks the right one from -DHALO_PANEL.
CONFIG_IDF_TARGET="esp32s3"

# Both boards carry 8 MB of OCTAL PSRAM (an N8R8 module on the development
# board, embedded 8 MB on the badge). Octal is not the default and neither
# board brings its PSRAM up without it. Octal also consumes IO35, IO36 and IO37.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_PARTITION_TABLE_CUSTOM=y

CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# 1 ms tick. At the 100 Hz default, pdMS_TO_TICKS(5) rounds to ZERO ticks, so the
# poll loop's vTaskDelay became a no-op, the idle task never ran and the task
# watchdog fired. 1 kHz also gives the gesture timings 1 ms resolution, which
# matters because F0 has to measure hold and double press on real hardware.
CONFIG_FREERTOS_HZ=1000

# NimBLE, peripheral only. The device is never a central and never scans: it
# talks to the phone and to nothing else.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# A 176 byte audio chunk needs an ATT MTU of at least 179. The phone asks for
# 517 and the smaller of the two wins, so 256 is the device's preference.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# The default main task stack is 3584 bytes. A display list plus the audio
# encoder's scratch buffers overflow it, which shows up as "stack overflow in
# task main" a second after boot. Large buffers are static now, and this is the
# margin on top.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
