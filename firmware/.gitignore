# Host test build
build/

# ESP-IDF build output. `build/` above covers the default directory; these are
# the per-board ones, so the two boards can be built side by side without
# reconfiguring between them.
board/build.crowpanel/
board/build.waveshare/
# Any per-board or bench build directory, wherever idf.py was run from. The
# bare pattern catches a stray one created by running idf.py from board/main/
# instead of board/, which is an easy slip and leaves a full build tree behind.
**/build.*/
.pio/
managed_components/
sdkconfig.old

# Generated by idf.py from the sdkconfig.defaults files; not source.
# One per board: board/sdkconfig.crowpanel and board/sdkconfig.waveshare.
# The sdkconfig.defaults* files ARE source and are not ignored.
board/sdkconfig
board/sdkconfig.crowpanel
board/sdkconfig.waveshare
board/dependencies.lock

# clangd index, written by the editor
.cache/

# Python bytecode from the bench tools
tools/__pycache__/

# Bench tool dependencies (bleak, pyserial). Not part of the firmware.
tools/.venv/

# Recordings from the bench tools. Evidence, not source.
tools/received_*.wav

# Bench builds, same reason as the two above.
board/build.*.bench/
