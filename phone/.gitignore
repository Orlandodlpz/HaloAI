/android/app/release

# Widget Preview related
.widget_preview/

# P0: ASR model files (~650 MB), pushed to the phone, never committed
models/
recordings/

# Python venv and caches for tools/ (fake BLE device)
.venv/
__pycache__/
.pytest_cache/

# P2: backend URL and API key, passed with --dart-define-from-file. Never commit
# it; config/backend.example.json lists the names.
config/backend.json
# P4: Orlando's separate real-scope key for testing the Google account
# screen on Carlos's own Google account. Never for approvals.
config/backend.google-test.json
